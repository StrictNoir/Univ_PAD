#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))

require 'optparse'
require 'smart_proxy/tools/http_client_demo'

options = {}

OptionParser.new do |opts|
  opts.banner = <<~BANNER
    Usage: http_client_demo [options]

    Runs the SmartProxy employee conflict scenario using Ruby.
  BANNER

  opts.on('--server1 URL', 'Primary server employee endpoint (default: ENV/localhost)') do |url|
    options[:server1_url] = url
  end

  opts.on('--server2 URL', 'Secondary server employee endpoint (default: ENV/localhost)') do |url|
    options[:server2_url] = url
  end

  opts.on('--sync-wait SECONDS', Integer, 'Seconds to wait for initial sync (default: 3)') do |seconds|
    options[:sync_wait_seconds] = seconds
  end

  opts.on('--resolution-wait SECONDS', Integer, 'Seconds to wait for conflict resolution (default: 5)') do |seconds|
    options[:resolution_wait_seconds] = seconds
  end

  opts.on('-h', '--help', 'Show this help message') do
    puts opts
    exit
  end
end.parse!

SmartProxy::Tools::HttpClientDemo.new(**options).perform_conflict_test
