{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RabbitMQ": {
    "Host": "message_broker",
    "Port": 5672,
    "Username": "${RABBITMQ_USER}",
    "Password": "${RABBITMQ_PASS}",
    "Exchange": {
      "Name": "WebApiExchange",
      "Type": "fanout",
      "Durable": true,
      "Exclusive": false,
      "AutoDelete": false
    },
    "Queue": {
      "Name": "WebApiQueue",
      "Durable": true,
      "Exclusive": false,
      "AutoDelete": false
    }
  }
}
